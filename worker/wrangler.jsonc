{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texlab-proxy",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Non-secret configuration. AIRTABLE_TOKEN is a secret, never a var:
  //   npx wrangler secret put AIRTABLE_TOKEN
  "vars": {
    "AIRTABLE_BASE_ID": "appbl0HDJ4cbQES5h",
    "AIRTABLE_METHODS_TABLE": "ISO,AATCC",
    "AIRTABLE_MEMBERS_TABLE": "Members",
    "MESSAGES_TABLE": "Messages",
    // "Ask AI" on a method's detail screen: answers are grounded in the method's attached PDF.
    // The key is a secret, never a var:
    //   npx wrangler secret put GEMINI_API_KEY
    "GEMINI_MODEL": "gemini-2.5-flash",
    // Gemini calls one Worker isolate may start per minute, so the free tier's RPM is not tripped.
    "GEMINI_RPM": "10",
    "FIREBASE_PROJECT_ID": "android-49288",
    // In-app updates: what GET /api/app/latest tells installed apps. Publish a new build, then
    // raise APP_VERSION_CODE and set APP_APK_URL to the signed APK's public https URL. Raise
    // APP_MIN_SUPPORTED to the new versionCode to force older installs to update.
    "APP_VERSION_CODE": "6",
    "APP_VERSION_NAME": "1.14",
    "APP_MIN_SUPPORTED": "1",
    "APP_APK_URL": "https://github.com/bdxqzz-bit/texlab/releases/download/v1.14/app-release.apk",
    "APP_RELEASE_NOTES": "Ask AI is now on every method's detail screen: ask questions about that method and get answers grounded in its PDF. Daily per-member question limit keeps usage fair."
  }
}
