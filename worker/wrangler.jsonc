{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texlab-proxy",
  "main": "index.mjs",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Invitation codes and the 7-day Pro trial they earn. Created with
  //   npx wrangler kv namespace create INVITES
  // Without this binding POST /api/invite answers 503 and the rest of the proxy is unaffected.
  "kv_namespaces": [{ "binding": "INVITES", "id": "6c865eaf41aa4f3b9aa07508c7d024be" }],
  // Non-secret configuration. AIRTABLE_TOKEN is a secret, never a var:
  //   npx wrangler secret put AIRTABLE_TOKEN
  "vars": {
    "AIRTABLE_BASE_ID": "appbl0HDJ4cbQES5h",
    "AIRTABLE_METHODS_TABLE": "ISO,AATCC",
    "AIRTABLE_MEMBERS_TABLE": "Members",
    "MESSAGES_TABLE": "Messages",
    // Method/document uploads a member submits to earn 1–30 days of Pro. The table needs these
    // columns: Title, Email, Name, File (attachment), File name, Content type, Size, Status,
    // Submitted at, Days (number), Pro until (text), Review note (optional).
    "AIRTABLE_UPLOADS_TABLE": "Method uploads",
    // "Ask AI" on a method's detail screen: answers are grounded in the method's attached PDF.
    // The key is a secret, never a var:
    //   npx wrangler secret put GEMINI_API_KEY
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    // Gemini calls one Worker isolate may start per minute, so the free tier's RPM is not tripped.
    "GEMINI_RPM": "10",
    "FIREBASE_PROJECT_ID": "android-49288",
    // In-app updates: what GET /api/app/latest tells installed apps. Publish a new build, then
    // raise APP_VERSION_CODE and set APP_APK_URL to the signed APK's public https URL. Raise
    // APP_MIN_SUPPORTED to the new versionCode to force older installs to update.
    "APP_VERSION_CODE": "12",
    "APP_VERSION_NAME": "0.1.20",
    "APP_MIN_SUPPORTED": "1",
    "APP_APK_URL": "https://github.com/bdxqzz-bit/texlab/releases/download/v0.1.20/app-release.apk",
    "APP_RELEASE_NOTES": "The admin method-review sheet now fits on any phone: the form scrolls and Approve, Reject and Close stay on screen. The referral prompt appears only for brand-new members, and the Pro days an invite earns come from the server.",
    // Days of Pro both sides get when an invitation code is redeemed (default 7).
    "INVITE_TRIAL_DAYS": "7"
  }
}
