# Copy to server/.env (git-ignored) and fill in. The server reads server/.env on start,
# but real environment variables always win, so a host's dashboard settings work too.

# Airtable personal access token: airtable.com/create/tokens
# Scope: data.records:read, with this base added to the token.
AIRTABLE_TOKEN=PASTE_AIRTABLE_PAT

# The base id from https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=PASTE_AIRTABLE_BASE_ID

# Method tables, comma separated. The table name becomes the category when a record
# has no Category field.
AIRTABLE_METHODS_TABLE=ISO,AATCC

# Allowlist table. Only rows with an active Status pass.
AIRTABLE_MEMBERS_TABLE=Members

# Firebase project whose ID tokens this server accepts. Must match
# app/google-services.json -> project_info.project_id.
FIREBASE_PROJECT_ID=android-49288

# HTTP port (most hosts set PORT themselves).
PORT=8080

# How long a member lookup is cached, in seconds. Lower it for faster revocation.
MEMBERSHIP_CACHE_SECONDS=300
